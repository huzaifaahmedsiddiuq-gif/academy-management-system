PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_academy_jwt_key_2025_prod_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------
# DATABASE SELECTION: "mysql" OR "supabase"
# ----------------------------------------------------
DATABASE_PROVIDER=mysql

# ----------------------------------------------------
# OPTION 1: MySQL Configuration
# ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=academy_db

# ----------------------------------------------------
# OPTION 2: Supabase (PostgreSQL) Configuration
# ----------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
